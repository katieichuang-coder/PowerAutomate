{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "sharepointSiteAddress": {
      "defaultValue": "https://contoso.sharepoint.com/sites/Surveys",
      "type": "String"
    },
    "sharepointListName": {
      "defaultValue": "SurveyAssignments",
      "type": "String"
    }
  },
  "triggers": {
    "Daily_at_9am": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "schedule": {
          "hours": ["9"],
          "minutes": [0]
        },
        "timeZone": "UTC"
      }
    }
  },
  "actions": {
    "Initialize_outstandingHtml": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "outstandingHtml",
            "type": "string",
            "value": ""
          }
        ]
      },
      "runAfter": {}
    },
    "todayDate": {
      "type": "Compose",
      "inputs": "@formatDateTime(utcNow(), 'yyyy-MM-dd')",
      "runAfter": {
        "Initialize_outstandingHtml": ["Succeeded"]
      }
    },
    "Get_outstanding_assignments": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItems",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
        },
        "parameters": {
          "dataset": "@parameters('sharepointSiteAddress')",
          "table": "@parameters('sharepointListName')",
          "$filter": "Completed eq 0 and ReleaseDate le '@{outputs('todayDate')}' and ResearchEndDate ge '@{utcNow()}'",
          "$top": 5000
        }
      },
      "runAfter": {
        "todayDate": ["Succeeded"]
      }
    },
    "Filter_trigger_rows": {
      "type": "Query",
      "inputs": {
        "from": "@outputs('Get_outstanding_assignments')?['body/value']",
        "where": "@and(lessOrEquals(formatDateTime(item()?['ReminderDate'], 'yyyy-MM-dd'), outputs('todayDate')), empty(item()?['LastReminderSent']))"
      },
      "runAfter": {
        "Get_outstanding_assignments": ["Succeeded"]
      }
    },
    "Select_trigger_emails": {
      "type": "Select",
      "inputs": {
        "from": "@body('Filter_trigger_rows')",
        "select": "@toLower(item()?['AssigneeEmail'])"
      },
      "runAfter": {
        "Filter_trigger_rows": ["Succeeded"]
      }
    },
    "Unique_assignee_emails": {
      "type": "Compose",
      "inputs": "@union(body('Select_trigger_emails'), body('Select_trigger_emails'))",
      "runAfter": {
        "Select_trigger_emails": ["Succeeded"]
      }
    },
    "For_each_unique_assignee": {
      "type": "Foreach",
      "foreach": "@outputs('Unique_assignee_emails')",
      "actions": {
        "Filter_this_assignees_outstanding": {
          "type": "Query",
          "inputs": {
            "from": "@outputs('Get_outstanding_assignments')?['body/value']",
            "where": "@equals(toLower(item()?['AssigneeEmail']), items('For_each_unique_assignee'))"
          }
        },
        "Reset_outstandingHtml": {
          "type": "SetVariable",
          "inputs": {
            "name": "outstandingHtml",
            "value": "@concat('')"
          },
          "runAfter": {
            "Filter_this_assignees_outstanding": ["Succeeded"]
          }
        },
        "For_each_outstanding_item": {
          "type": "Foreach",
          "foreach": "@body('Filter_this_assignees_outstanding')",
          "actions": {
            "Append_outstanding_list_item": {
              "type": "AppendToStringVariable",
              "inputs": {
                "name": "outstandingHtml",
                "value": "<li><strong>@{items('For_each_outstanding_item')?['Title']}</strong> &mdash; <a href=\"@{items('For_each_outstanding_item')?['SurveyLink']}\">Open survey</a><br><em>Task:</em> @{items('For_each_outstanding_item')?['TaskInstructions']}</li>"
              }
            }
          },
          "runAfter": {
            "Reset_outstandingHtml": ["Succeeded"]
          }
        },
        "Research_end_pretty": {
          "type": "Compose",
          "inputs": "@formatDateTime(first(body('Filter_this_assignees_outstanding'))?['ResearchEndDate'], 'dddd d MMMM yyyy, h:mm tt')",
          "runAfter": {
            "For_each_outstanding_item": ["Succeeded"]
          }
        },
        "Get_assignee_profile": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365users",
              "operationId": "UserProfile_V2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365users"
            },
            "parameters": {
              "id": "@items('For_each_unique_assignee')"
            }
          },
          "runAfter": {
            "Research_end_pretty": ["Succeeded"]
          }
        },
        "Send_reminder_email": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/To": "@items('For_each_unique_assignee')",
              "emailMessage/Subject": "Reminder: outstanding survey(s) to complete",
              "emailMessage/Body": "<p>Hi @{coalesce(outputs('Get_assignee_profile')?['body/givenName'], 'there')},</p><p>You still have <strong>@{length(body('Filter_this_assignees_outstanding'))}</strong> outstanding survey(s) to complete before the research period closes on <strong>@{outputs('Research_end_pretty')}</strong>:</p><ul>@{variables('outstandingHtml')}</ul><p><b>Still need the app?</b></p><ol><li>Open TestFlight &rarr; find Linkt &rarr; tap Install. Work through your tasks when you're ready.</li></ol><p>Email <a href=\"mailto:[SUPPORT EMAIL]\">[SUPPORT EMAIL]</a> if you need a hand &mdash; we're here during business hours.</p><p>Thanks,<br>[name]<br>Linkt Research Team</p><p>[TU email signature logo]</p><p>[support email]</p>",
              "emailMessage/Importance": "Normal"
            }
          },
          "runAfter": {
            "Get_assignee_profile": ["Succeeded"]
          }
        }
      },
      "runAfter": {
        "Unique_assignee_emails": ["Succeeded"]
      }
    },
    "For_each_trigger_row_stamp_reminder_sent": {
      "type": "Foreach",
      "foreach": "@body('Filter_trigger_rows')",
      "actions": {
        "Stamp_LastReminderSent": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('sharepointSiteAddress')",
              "table": "@parameters('sharepointListName')",
              "id": "@items('For_each_trigger_row_stamp_reminder_sent')?['ID']",
              "item/Title": "@items('For_each_trigger_row_stamp_reminder_sent')?['Title']",
              "item/LastReminderSent": "@utcNow()"
            }
          }
        }
      },
      "runAfter": {
        "For_each_unique_assignee": ["Succeeded"]
      }
    }
  }
}
