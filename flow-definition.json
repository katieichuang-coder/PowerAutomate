{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "sharepointSiteAddress": {
      "defaultValue": "https://contoso.sharepoint.com/sites/Surveys",
      "type": "String"
    },
    "sharepointListName": {
      "defaultValue": "SurveyAssignments",
      "type": "String"
    }
  },
  "triggers": {
    "Daily_at_9am": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "schedule": {
          "hours": ["9"],
          "minutes": [0]
        },
        "timeZone": "UTC"
      }
    }
  },
  "actions": {
    "todayDate": {
      "type": "Compose",
      "inputs": "@formatDateTime(utcNow(), 'yyyy-MM-dd')",
      "runAfter": {}
    },
    "Get_outstanding_assignments": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItems",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
        },
        "parameters": {
          "dataset": "@parameters('sharepointSiteAddress')",
          "table": "@parameters('sharepointListName')",
          "$filter": "Completed eq 0 and ReleaseDate le '@{outputs('todayDate')}' and ResearchEndDate ge '@{utcNow()}'",
          "$top": 5000
        }
      },
      "runAfter": {
        "todayDate": ["Succeeded"]
      }
    },
    "Filter_trigger_rows": {
      "type": "Query",
      "inputs": {
        "from": "@outputs('Get_outstanding_assignments')?['body/value']",
        "where": "@and(lessOrEquals(item()?['ReminderDate'], outputs('todayDate')), equals(item()?['LastReminderSent'], null))"
      },
      "runAfter": {
        "Get_outstanding_assignments": ["Succeeded"]
      }
    },
    "Select_trigger_emails": {
      "type": "Select",
      "inputs": {
        "from": "@body('Filter_trigger_rows')",
        "select": "@toLower(item()?['AssigneeEmail'])"
      },
      "runAfter": {
        "Filter_trigger_rows": ["Succeeded"]
      }
    },
    "Unique_assignee_emails": {
      "type": "Compose",
      "inputs": "@union(body('Select_trigger_emails'), body('Select_trigger_emails'))",
      "runAfter": {
        "Select_trigger_emails": ["Succeeded"]
      }
    },
    "For_each_unique_assignee": {
      "type": "Foreach",
      "foreach": "@outputs('Unique_assignee_emails')",
      "actions": {
        "Filter_this_assignees_outstanding": {
          "type": "Query",
          "inputs": {
            "from": "@outputs('Get_outstanding_assignments')?['body/value']",
            "where": "@equals(toLower(item()?['AssigneeEmail']), items('For_each_unique_assignee'))"
          }
        },
        "Select_outstanding_list_items": {
          "type": "Select",
          "inputs": {
            "from": "@body('Filter_this_assignees_outstanding')",
            "select": "<li><strong>@{item()?['Title']}</strong> &mdash; <a href=\"@{item()?['SurveyLink']}\">Open survey</a></li>"
          },
          "runAfter": {
            "Filter_this_assignees_outstanding": ["Succeeded"]
          }
        },
        "Research_end_pretty": {
          "type": "Compose",
          "inputs": "@formatDateTime(first(body('Filter_this_assignees_outstanding'))?['ResearchEndDate'], 'dddd d MMMM yyyy, h:mm tt')",
          "runAfter": {
            "Select_outstanding_list_items": ["Succeeded"]
          }
        },
        "Send_reminder_email": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/To": "@items('For_each_unique_assignee')",
              "emailMessage/Subject": "Reminder: outstanding survey(s) to complete",
              "emailMessage/Body": "<p>Hi,</p><p>You still have <strong>@{length(body('Filter_this_assignees_outstanding'))}</strong> outstanding survey(s) to complete before the research period closes on <strong>@{outputs('Research_end_pretty')}</strong>:</p><ul>@{join(body('Select_outstanding_list_items'), '')}</ul><p>Thanks!</p>",
              "emailMessage/Importance": "Normal"
            }
          },
          "runAfter": {
            "Research_end_pretty": ["Succeeded"]
          }
        }
      },
      "runAfter": {
        "Unique_assignee_emails": ["Succeeded"]
      }
    },
    "For_each_trigger_row_stamp_reminder_sent": {
      "type": "Foreach",
      "foreach": "@body('Filter_trigger_rows')",
      "actions": {
        "Stamp_LastReminderSent": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('sharepointSiteAddress')",
              "table": "@parameters('sharepointListName')",
              "id": "@items('For_each_trigger_row_stamp_reminder_sent')?['ID']",
              "item/Title": "@items('For_each_trigger_row_stamp_reminder_sent')?['Title']",
              "item/LastReminderSent": "@utcNow()"
            }
          }
        }
      },
      "runAfter": {
        "For_each_unique_assignee": ["Succeeded"]
      }
    }
  }
}
